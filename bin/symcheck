#!/bin/sh
# Usage: symcheck target binary
#
# Symcheck checks a program of the game on SDL3 that make links, for the
# target that built it, named as its directory (linux-amd64-gcc). A
# Linux program must export the symbols of the C runtime's startup
# alone: a symbol that it exports overrides the shared libraries' symbol
# of that name, as the game's random or logf would override libc's and
# libm's. A Windows program, and every DLL beside it, may import the
# DLLs of the system and the DLLs of its folder, so that the folder
# holds all that the program loads. So may a macOS program and every
# dylib beside it, with the libraries of the system, each built for the
# target's architecture alone and for the program's oldest macOS.

set -eu

usage() {
	echo 'usage: symcheck target binary' >&2
	exit 2
}

[ $# -eq 2 ] || usage
target=$1
bin=$2
if [ ! -f "$bin" ]; then
	echo "symcheck: $bin: no such file" >&2
	exit 1
fi

case $target in
*-asan | *-tsan)
	# The sanitizers' runtime exports libc's names on purpose, to
	# intercept them.
	;;
windows-386-* | windows-amd64-*)
	case $target in
	windows-386-*) objdump=i686-w64-mingw32-objdump ;;
	*) objdump=x86_64-w64-mingw32-objdump ;;
	esac
	dir=$(dirname -- "$bin")
	status=0
	for f in "$bin" "$dir"/*.dll; do
		[ -e "$f" ] || continue
		if ! dump=$("$objdump" -p "$f"); then
			echo "symcheck: $objdump -p $f failed" >&2
			exit 1
		fi
		for dll in $(printf '%s\n' "$dump" | sed -n 's/^[[:space:]]*DLL Name: //p' | tr '[:upper:]' '[:lower:]'); do
			case $dll in
			advapi32.dll | dsound.dll | gdi32.dll | imm32.dll | kernel32.dll | msvcrt.dll | \
			ole32.dll | oleaut32.dll | setupapi.dll | shell32.dll | user32.dll | version.dll | \
			winmm.dll | ws2_32.dll | api-ms-win-*.dll)
				continue
				;;
			esac
			if [ -z "$(find "$dir" -maxdepth 1 -iname "$dll" -print)" ]; then
				echo "symcheck: $f needs $dll, which its folder lacks" >&2
				status=1
			fi
		done
	done
	exit "$status"
	;;
macos-amd64-* | macos-arm64-*)
	case $target in
	macos-amd64-*) arch=x86_64 ;;
	*) arch=arm64 ;;
	esac
	dir=$(dirname -- "$bin")
	minos() {
		otool -l "$1" | awk '$1 == "minos" { print $2; exit }'
	}
	want=$(minos "$bin")
	status=0
	for f in "$bin" "$dir"/*.dylib; do
		[ -e "$f" ] || continue
		archs=$(lipo -archs "$f")
		if [ "$archs" != "$arch" ]; then
			echo "symcheck: $f holds $archs, where $target wants $arch alone" >&2
			status=1
		fi
		if [ "$(minos "$f")" != "$want" ]; then
			echo "symcheck: $f wants macOS $(minos "$f"), where the program wants $want" >&2
			status=1
		fi
		# otool -D prints a dylib's own name on its second line.
		id=$(otool -D "$f" | sed -n 2p)
		for lib in $(otool -L "$f" | sed -n 's/^[[:space:]]*\([^[:space:]]*\) (compatibility .*/\1/p'); do
			[ "$lib" != "$id" ] || continue
			case $lib in
			/usr/lib/* | /System/Library/*)
				continue
				;;
			@rpath/*)
				[ ! -e "$dir/${lib#@rpath/}" ] || continue
				;;
			esac
			echo "symcheck: $f needs $lib, which its folder lacks" >&2
			status=1
		done
	done
	exit "$status"
	;;
linux-*)
	if ! dump=$(nm -D --defined-only "$bin"); then
		echo "symcheck: nm -D $bin failed" >&2
		exit 1
	fi
	syms=$(printf '%s\n' "$dump" | awk '{ print $NF }' | grep -v -x -E \
		'_IO_stdin_used|__bss_start|_edata|_end|_fini|_init|__data_start|data_start|__dso_handle|_start|main|__TMC_END__' || :)
	if [ -n "$syms" ]; then
		printf 'symcheck: %s exports what shared libraries may call in its place: %s\n' \
			"$bin" "$(echo "$syms" | tr '\n' ' ')" >&2
		exit 1
	fi
	;;
*)
	usage
	;;
esac
